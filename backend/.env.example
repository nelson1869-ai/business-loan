APP_NAME=Lending Nelson API
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5434/lending_nelson
JWT_SECRET_KEY=replace-with-a-secure-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

N8N_WEBHOOK_URL=http://localhost:5678/webhook/lending-events
N8N_WEBHOOK_SECRET=replace-with-a-secure-webhook-secret

NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


BUSINESS_TIMEZONE=Asia/Manila
CURRENCY_CODE=PHP
AI_ENABLED=true
AI_PROVIDER=nvidia
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=160
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=0
AI_CACHE_TTL_SECONDS=300
AI_FAILURE_COOLDOWN_SECONDS=120
ASSISTANT_RATE_LIMIT_PER_MINUTE=30
# Optional. Leave blank to use the bounded process-local fallback.
ASSISTANT_RATE_LIMIT_REDIS_URL=
