# Lending Nelson API — Environment Configuration Blueprint

# Application Environment: 'development', 'test', 'staging', or 'production'
APP_NAME=Lending Nelson API
APP_ENV=development

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/lending_nelson

# JWT Configuration (MUST be a strong, random key >= 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated. Wildcard '*' disallowed in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# n8n Webhook Integration (N8N_WEBHOOK_SECRET is mandatory in production/staging when N8N_WEBHOOK_URL is set)
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lending-events
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=5
N8N_MAX_ATTEMPTS=8
N8N_RETRY_BASE_SECONDS=30
N8N_SIGNATURE_MAX_AGE_SECONDS=300
N8N_SERVICE_API_KEY=

# AI Provider Configuration (NVIDIA NIM Integration)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Platform Settings
BUSINESS_TIMEZONE=Asia/Manila
CURRENCY_CODE=PHP
AI_ENABLED=true
AI_PROVIDER=nvidia
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=160
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=0
AI_CACHE_TTL_SECONDS=300
AI_FAILURE_COOLDOWN_SECONDS=120
ASSISTANT_RATE_LIMIT_PER_MINUTE=30
# Optional. Leave blank to use the bounded process-local fallback.
ASSISTANT_RATE_LIMIT_REDIS_URL=
LOGIN_RATE_LIMIT_PER_MINUTE=5
