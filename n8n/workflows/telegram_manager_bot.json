{
  "name": "Lending Nelson - Telegram Manager Approval Bot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lending-manager-alert",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.eventType }}",
              "value2": "loan.created"
            }
          ]
        }
      },
      "name": "Is New Loan Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_MANAGER_CHAT_ID }}",
        "text": "=📢 *NEW LOAN APPLICATION CREATED*\n\n👤 *Borrower:* {{ $json.body.data.borrower_name }}\n💰 *Principal:* ₱{{ $json.body.data.original_principal }}\n📌 *Status:* {{ $json.body.data.status }}\n🧑‍💼 *Submitted By:* {{ $json.body.data.created_by }}\n🆔 *Loan ID:* `{{ $json.body.data.loan_id }}`\n\nReview in Lending Nelson App or Web Dashboard.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Send Telegram Alert to Manager",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        680,
        220
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Is New Loan Event?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is New Loan Event?": {
      "main": [
        [
          {
            "node": "Send Telegram Alert to Manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
