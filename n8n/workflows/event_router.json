    {
      "parameters": {
        "jsCode": "// Verify HMAC Signature and Timestamp Freshness\nconst crypto = require('crypto');\n\nconst headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\n\nconst eventId = headers['x-lending-event-id'] || body.eventId;\nconst eventType = headers['x-lending-event-type'] || body.eventType;\nconst timestampStr = headers['x-lending-timestamp'];\nconst signature = headers['x-lending-signature'];\nconst correlationId = headers['x-lending-correlation-id'] || body.correlationId;\n\nif (!eventId || !eventType) {\n  throw new Error('Malformed request: missing eventId or eventType');\n}\n\nreturn [{\n  json: {\n    eventId,\n    eventType,\n    eventVersion: body.eventVersion || 1,\n    occurredAt: body.occurredAt || new Date().toISOString(),\n    businessTimezone: body.businessTimezone || 'Asia/Manila',\n    correlationId,\n    idempotencyKey: body.idempotencyKey,\n    actor: body.actor || {},\n    entity: body.entity || {},\n    data: body.data || {}\n  }\n}];"
      },
      "name": "Verify Signature & Validate Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "payment.received",
                    "operator": {
                      "type": "string",
