{
  "name": "Lending Nelson - Payment Receipt SMS & Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lending-payment-receipt",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.eventType }}",
              "value2": "payment.received"
            }
          ]
        }
      },
      "name": "Is Payment Received Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.semaphore.co/api/v4/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"apikey\": \"={{ $env.SEMAPHORE_API_KEY }}\",\n  \"number\": \"={{ $json.body.data.borrower_phone }}\",\n  \"message\": \"Lending Nelson: Thank you! We received your payment of ₱{{ $json.body.data.amount_paid }} for Loan #{{ $json.body.data.loan_id }}. Remaining balance: ₱{{ $json.body.data.remaining_balance }}. (Ref: {{ $json.body.eventId }})\"\n}",
        "options": {}
      },
      "name": "Send Borrower SMS (Semaphore)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        680,
        220
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Is Payment Received Event?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Payment Received Event?": {
      "main": [
        [
          {
            "node": "Send Borrower SMS (Semaphore)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
